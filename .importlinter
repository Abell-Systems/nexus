[importlinter]
root_packages =
    domain
    application
    infrastructure
include_external_packages = True

[importlinter:contract:domain-isolation]
name = Domain layer must not depend on application or infrastructure
type = forbidden
source_modules =
    domain
forbidden_modules =
    application
    infrastructure

[importlinter:contract:application-isolation]
name = Application layer must not depend on infrastructure
type = forbidden
source_modules =
    application
forbidden_modules =
    infrastructure

[importlinter:contract:evaluation-adapter-boundary]
name = Only matching_adapter may import matching domain from evaluation
type = forbidden
source_modules =
    application.evaluation
forbidden_modules =
    domain.models.matching
    domain.protocols.matching
    application.matching
ignore_imports =
    application.evaluation.matching_adapter -> domain.models.matching
    application.evaluation.matching_adapter -> domain.protocols.matching

[importlinter:contract:evaluation-metrics-purity]
name = Evaluation metrics must not depend on matching domain or infrastructure
type = forbidden
source_modules =
    application.evaluation.metrics
forbidden_modules =
    infrastructure
    domain.models.matching
    domain.protocols.matching
    application.matching

[importlinter:contract:evaluation-runner-isolation]
name = Evaluation runner must not depend on matching domain
type = forbidden
source_modules =
    application.evaluation.runner
forbidden_modules =
    infrastructure
    domain.models.matching
    domain.protocols.matching
    application.matching

[importlinter:contract:evaluation-domain-protocol-isolation]
name = Evaluation domain protocols must not depend on matching domain
type = forbidden
source_modules =
    domain.protocols.evaluation
forbidden_modules =
    domain.models.matching
    domain.protocols.matching
    application.matching
    infrastructure

[importlinter:contract:provider-sdk-isolation]
name = Domain and Application must not import provider SDKs
type = forbidden
source_modules =
    domain
    application
forbidden_modules =
    google
    openai
    anthropic
    litellm
    langgraph
    llama_index

[importlinter:contract:embedding-generation-stack-isolation]
name = Nexus runtime must not import the offline M1 embedding-generation stack (ADR 0014)
type = forbidden
source_modules =
    domain
    application
    infrastructure
forbidden_modules =
    torch
    transformers
    sentence_transformers

[importlinter:contract:whitespace-independent-of-matching]
name = White-space analysis must not depend on offer-demand matching, demands or their evaluation
type = forbidden
source_modules =
    domain.models.whitespace
    domain.protocols.whitespace
    application.whitespace
    infrastructure.sources.patent.oepm_biblio
forbidden_modules =
    domain.models.matching
    domain.models.demand
    domain.models.evaluation
    domain.protocols.matching
    domain.protocols.evaluation
    application.matching
    application.evaluation
    infrastructure.matching
    infrastructure.operational

[importlinter:contract:matching-independent-of-whitespace]
name = Offer-demand matching and its evaluation must not depend on white-space analysis
type = forbidden
source_modules =
    domain.models.matching
    domain.models.demand
    domain.models.evaluation
    domain.protocols.matching
    domain.protocols.evaluation
    application.matching
    application.evaluation
    infrastructure.matching
    infrastructure.operational
forbidden_modules =
    domain.models.whitespace
    domain.protocols.whitespace
    application.whitespace
    infrastructure.sources.patent.oepm_biblio
